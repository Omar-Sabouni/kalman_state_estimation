{
  "name": "kalman-state-estimation-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && playwright test",
    "check": "npm run test:coverage && npm run build"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.59.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.0",
    "typescript": "^6.0.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.0"
  }
}
